# Copy to config.env only when overriding these defaults.

WORK_DIR="$HOME/llama-low-vram-repro"
SOURCE_DIR="$WORK_DIR/llama-cpp-turboquant"
BUILD_DIR="$SOURCE_DIR/build"
MODEL_DIR="$WORK_DIR/models"
RESULTS_DIR="$WORK_DIR/results"

# Pinned snapshots verified on 2026-07-21.
LLAMA_REPO="https://github.com/TheTom/llama-cpp-turboquant.git"
LLAMA_REV="c26cbdffcf6fc9b7430cd6b117757e9a3f70b7ea"
MODEL_REPO="unsloth/Qwen3.6-35B-A3B-GGUF"
MODEL_REV="a483e9e6cbd595906af30beda3187c2663a1118c"
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_S.gguf"
MODEL_SHA256="a8138f183e3993f12cdc23afd2babb8cdb084e64088ce4a256d49101d47b949c"

# Optional reconstruction of the video's failed external draft experiment.
DRAFT_REPO="unsloth/Qwen3.5-0.8B-GGUF"
DRAFT_REV="6ab461498e2023f6e3c1baea90a8f0fe38ab64d0"
DRAFT_FILE="Qwen3.5-0.8B-Q4_K_M.gguf"
DRAFT_SHA256="bd258782e35f7f458f8aced1adc053e6e92e89bc735ba3be89d38a06121dc517"

# GTX 1070 is Pascal compute capability 6.1. Real-only SASS avoids PTX JIT
# incompatibility between newer CUDA 12 toolkits and this host's R535 driver.
CUDA_ARCH="61-real"
CUDA_ROOT="/usr/local/cuda-12.2"
BUILD_JOBS="4"

# The host has four physical Skylake cores and eight logical CPUs.
THREADS="4"
THREADS_BATCH="8"
BASE_CONTEXT="4096"
N_PREDICT="128"
BASELINE_NGL="20"
CPU_MOE_ALL="41"
CPU_MOE_TUNED="35"
CPU_MOE_LONG_CONTEXT="36"

# Additional arguments may be passed directly to every run script.
PROMPT="Explain in five concise points why mixture-of-experts inference can use less compute than a dense model."
