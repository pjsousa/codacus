# Copy to config.env only when overriding these defaults.

WORK_DIR="$HOME/llama-low-vram-repro"
SOURCE_DIR="$WORK_DIR/llama-cpp-turboquant"
BUILD_DIR="$SOURCE_DIR/build"
MODEL_DIR="$WORK_DIR/models"
RESULTS_DIR="$WORK_DIR/results"

# Pinned revision from the project-01 build verified on 2026-07-21.
LLAMA_REV="c26cbdffcf6fc9b7430cd6b117757e9a3f70b7ea"

# Select a model to serve. The video does not specify a model; pick one
# already present in MODEL_DIR or set an explicit path.
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_S.gguf"
# MODEL_FILE="Qwen3.6-28B-REAP20-A3B-Q4_K_M.gguf"
# MODEL_PATH="/absolute/path/to/model.gguf"

LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8080"

THREADS="4"
THREADS_BATCH="8"
BASE_CONTEXT="4096"

# Docker stack ports
ANYTHING_LLM_PORT="3001"
N8N_PORT="5678"

# Docker stack data directories
ANYTHING_LLM_DATA_DIR="$WORK_DIR/anythingllm-data"
N8N_DATA_DIR="$WORK_DIR/n8n-data"
DOCKER_COMPOSE_DIR="$WORK_DIR/docker-stack"

# Pi coding agent install directory
PI_INSTALL_DIR="$WORK_DIR/pi"
