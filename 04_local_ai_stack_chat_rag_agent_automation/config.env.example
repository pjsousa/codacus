# Copy to config.env only when overriding these defaults.

# Existing project-01 llama.cpp TurboQuant build (consumed read-only; never
# cloned, rebuilt, or modified by this project).
WORK_DIR="$HOME/llama-low-vram-repro"
SOURCE_DIR="$WORK_DIR/llama-cpp-turboquant"
BUILD_DIR="$SOURCE_DIR/build"
MODEL_DIR="$WORK_DIR/models"

# Pinned build revision, verified installed on 2026-07-22.
LLAMA_REV="c26cbdffcf6fc9b7430cd6b117757e9a3f70b7ea"

# Default served model (pinned in project 01; already present on this host).
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_S.gguf"
MODEL_SHA256="a8138f183e3993f12cdc23afd2babb8cdb084e64088ce4a256d49101d47b949c"

# Project-local runtime state: generated presets/compose files, PID files,
# logs, and validation reports. PROJECT_DIR is resolved by scripts/_common.sh
# before this file is sourced.
STACK_DIR="$PROJECT_DIR/stack"
RESULTS_DIR="$PROJECT_DIR/results"

# Engine (chapter 1:08). The video's port 8080 is occupied on this host by an
# existing Dify container, so the router defaults to 8088 on loopback only.
ROUTER_HOST="127.0.0.1"
ROUTER_PORT="8088"
MODEL_ALIAS="local-chat"
MODELS_MAX="1"
SLEEP_IDLE_SECONDS="-1"
# Engine placement/cache defaults follow project 01's measured safer profile.
ENGINE_NGL="all"
ENGINE_CPU_MOE="40"
ENGINE_CTX="65536"
ENGINE_CACHE_K="q8_0"
ENGINE_CACHE_V="turbo4"
ENGINE_NO_MMAP="1"
ENGINE_MLOCK="0"
THREADS="4"
THREADS_BATCH="8"
# Optional: set to require an API key on the engine endpoint.
LLAMA_API_KEY=""

# Optional alternative router from the video (chapter 1:08), pinned release
# verified on 2026-07-22.
LLAMA_SWAP_VERSION="241"
LLAMA_SWAP_SHA256="4321cc7772d823c988a8e24a0045a9de1893be935048939e8422cb5924ab75d8"
LLAMA_SWAP_PORT="8089"

# Chat UI + RAG (chapters 2:55 and 4:49), image tag verified on 2026-07-22.
ANYTHINGLLM_IMAGE="mintplexlabs/anythingllm:1.15.0"
ANYTHINGLLM_PORT="3001"
# Pinned sample document standing in for the video's own research papers.
SWIN_PDF_URL="https://arxiv.org/pdf/2103.14030"
SWIN_PDF_FILE="Swin-Transformer-arXiv-2103.14030.pdf"
SWIN_PDF_SHA256="dfdc7631fe2a35bb5892080b9c0eeadc4432d55cf1856f84bc88802efa877a7c"

# Coding agent (chapter 7:08), npm versions verified on 2026-07-22.
PI_PACKAGE="@earendil-works/pi-coding-agent"
PI_VERSION="0.81.1"
PI_LLAMA_CPP_PACKAGE="pi-llama-cpp"
PI_LLAMA_CPP_VERSION="0.9.1"

# Automation (chapter 9:05). Tag matches the n8n docs "current stable" on
# 2026-07-22; newer tags exist on the registry.
N8N_IMAGE="docker.n8n.io/n8nio/n8n:2.29.8"
N8N_PORT="5678"
GENERIC_TIMEZONE="UTC"

# Smoke-test workload kept fixed across chapters for comparable evidence.
SMOKE_PROMPT="Reply with exactly: local engine online"
SMOKE_MAX_TOKENS="32"
